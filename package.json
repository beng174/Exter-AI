{
  "name": "exter-ai",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_USE_ENV_PROXY=1 NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build:preview": "tsx scripts/build-preview.ts",
    "mcp": "node --import tsx scripts/claude-mcp.ts",
    "models:verify": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/verify-brain.ts",
    "research:valentte": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/test-valentte.ts",
    "import:meta-library": "node --import tsx scripts/import-meta-library.ts",
    "claude:setup": "node scripts/setup-claude-mac.mjs",
    "video:analyse": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/analyse-video.ts",
    "video:evaluate": "node --import tsx scripts/evaluate-video.ts",
    "worker": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx server/infrastructure/runtime.ts worker",
    "scheduler": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx server/infrastructure/runtime.ts scheduler",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/infrastructure/runtime.ts migrate",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test:infrastructure": "tsx --test --test-concurrency=1 tests/infrastructure.integration.ts tests/meta-activation.integration.ts tests/meta-observation-storage.integration.ts tests/meta-recovery.integration.ts tests/creator-discovery.integration.ts tests/kernel-*.integration.ts",
    "kernel:next": "node scripts/kernel-backlog.mjs next",
    "kernel:task": "node scripts/kernel-backlog.mjs show",
    "kernel:skills:verify": "node --import tsx --test tests/kernel-skills.test.ts",
    "test:owned": "tsx --test --test-concurrency=1 tests/owned-sync.integration.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
