# Optional extraction worker image. Never used by the web service.
FROM node:24-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    NODE_USE_ENV_PROXY=1 npm ci --strict-ssl=true
COPY worker/requirements-scenes.txt /app/worker/requirements-scenes.txt
RUN python3 -m venv /opt/exter-worker
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    /opt/exter-worker/bin/pip install --no-cache-dir -r worker/requirements-scenes.txt
COPY worker/requirements-audio.txt /app/worker/requirements-audio.txt
ARG EXTER_BUILD_AUDIO=false
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    if [ "$EXTER_BUILD_AUDIO" = true ]; then /opt/exter-worker/bin/pip install --no-cache-dir -r worker/requirements-audio.txt; fi
COPY worker/requirements-visual*.txt /app/worker/
ARG EXTER_BUILD_VISUAL=false
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    if [ "$EXTER_BUILD_VISUAL" = true ]; then /opt/exter-worker/bin/pip install --no-cache-dir -r worker/requirements-visual-runtime.txt && /opt/exter-worker/bin/pip install --no-cache-dir --no-deps -r worker/requirements-visual.txt; fi
COPY . .
ENV EXTER_KERNEL_PYTHON=/opt/exter-worker/bin/python OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
CMD ["npm", "run", "worker"]
