# Copy to .env locally, or configure these in the hosting environment. Existing environment values take precedence.
# Add credentials through your hosting/environment secret settings, never in chat or git.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
# Confidence scores are retained for auditing only; no automatic threshold applies.
GEMINI_GENERATION_SEED=42
GEMINI_MEDIA_RESOLUTION=default
# Mount both the database and media directory on persistent storage.
EXTER_DB_PATH=.data/exter.db
EXTER_MEDIA_ROOT=.data/media
EXTER_MEDIA_ALLOWED_HOSTS=*.fbcdn.net

# HTTP Basic Auth: both required in production; applies to pages, static files and APIs.
EXTER_ADMIN_USER=
EXTER_ADMIN_PASSWORD=
DATABASE_URL=
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
# Commercial ad-library API; requires approved TikTok research.adlib.basic access.
# Missing either key leaves the API not connected. Add only through secure runtime settings.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APIFY_TOKEN=
# Optional public creator discovery. Select compatible actors in your Apify account.
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
# Conservative GBP reservation before each paid actor run; uses data_providers budget.
APIFY_REQUEST_RESERVE_GBP=
YOUTUBE_API_KEY=
MEDIA_STORAGE_TYPE=disk
MEDIA_STORAGE_PATH=.data/media
# Conservative GBP hold per request; explicit rejection retries reuse it.
# Ambiguous timeout retries retain the earlier hold and reserve independently.
# Set above the maximum plausible cost for your permitted video inputs/output limit.
GEMINI_REQUEST_RESERVE_GBP=
# Current model prices converted to GBP, per million tokens; no rates are invented.
GEMINI_INPUT_GBP_PER_MILLION_TOKENS=
GEMINI_OUTPUT_GBP_PER_MILLION_TOKENS=
# Bind the two rates above to this exact served model (defaults to GEMINI_VIDEO_MODEL).
GEMINI_PRICING_MODEL=gemini-3.8-flash
# Optional exact-model overrides: {"model-id":{"inputGbpPerMillion":N,"outputGbpPerMillion":N}}
# Use current GBP prices. A served-model mismatch without a matching rate retains the hold.
GEMINI_MODEL_PRICING_GBP_JSON=
# Hosted smoke-test worker parallelism (bounded; default 3).
GEMINI_VIDEO_CONCURRENCY=3
GEMINI_MAX_RETRIES=2
# Browser used only to resolve public video URLs when hosted media is missing.
CHROMIUM_PATH=/usr/bin/chromium
EXTER_BACKUPS_ENABLED=false
EXTER_BACKUP_PATH=.data/backups
