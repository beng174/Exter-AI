# Configure these in the server environment; this example is not loaded automatically.
# Add credentials through your hosting/environment secret settings, never in chat or git.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
EXTER_VIDEO_CONFIDENCE=0.75
# Mount both the database and media directory on persistent storage.
EXTER_DB_PATH=.data/exter.db
EXTER_MEDIA_ROOT=.data/media
EXTER_MEDIA_ALLOWED_HOSTS=*.fbcdn.net
